# Database configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Database connection string
DATABASE_URL=

# Database direct connection string
DIRECT_URL=

# Emailing
# Local dev (MailHog): set SMTP_HOST=mailhog (Docker) or localhost (pnpm dev on host).
# Production: leave SMTP_HOST empty — Gmail is used with SMTP_USER/SMTP_PASS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# AWS
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_URL=
# Firma de las URLs de la galería (CloudFront key group). La clave privada va en base64:
# base64 -i private.pem | tr -d '\n'
AWS_CLOUDFRONT_KEY_PAIR_ID=
AWS_CLOUDFRONT_PRIVATE_KEY_BASE64=
# Optional: raises the GitHub API rate limit for the /desarrollo collaboration stats
GITHUB_TOKEN=
