# Database configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Database connection string
DATABASE_URL=

# Database direct connection string
DIRECT_URL=

# Two-factor sign-in: encrypts each user's authenticator secret. Required in production (the
# server won't start without it); optional locally, where a fixed dev key is used.
# openssl rand -base64 32
TWO_FACTOR_ENCRYPTION_KEY=

# Emailing
# Production: Resend (RESEND_API_KEY). The sender must be on a domain verified in Resend;
# EMAIL_FROM overrides the default no-reply@programaconnosotros.com.
# Local dev: MailHog with SMTP_HOST=mailhog (Docker) or localhost (pnpm dev on host), and no
# RESEND_API_KEY so nothing reaches real inboxes. EMAIL_TRANSPORT=json sends nothing at all.
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=

# Agente que carga charlas a partir de su foto (/charlas → cargarConFoto). Llama al modelo por
# Vercel AI Gateway: una API key de https://vercel.com/ai-gateway. Sin ella el agente avisa que
# falta y el resto del sitio anda igual.
AI_GATEWAY_API_KEY=

# AWS
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_URL=
# Firma de las URLs de la galería (CloudFront key group). La clave privada va en base64:
# base64 -i private.pem | tr -d '\n'
AWS_CLOUDFRONT_KEY_PAIR_ID=
AWS_CLOUDFRONT_PRIVATE_KEY_BASE64=
# Optional: raises the GitHub API rate limit for the /desarrollo collaboration stats, and is
# required for the live total of GitHub contributions on each profile (GraphQL API; a classic
# token with no scopes, or a fine-grained one with public read access, is enough). Without it
# the profile just doesn't show that number.
GITHUB_TOKEN=
